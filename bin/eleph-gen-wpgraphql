#!/usr/bin/env php
<?php

declare(strict_types=1);

use Eleph\Gen\WPGraphQL\Integration\WpGraphQL;
use Eleph\Gen\WPGraphQL\Manifest\ManifestBuilder;
use Eleph\Gen\WPGraphQL\Manifest\ManifestExporter;
use Eleph\Gen\WPGraphQL\Protocol\BuilderEnvelope;
use Eleph\Gen\WPGraphQL\Verification\VerifierExporter;
use Eleph\Gen\WPGraphQL\Wire\IntegrationCodec;
use Eleph\Gen\WPGraphQL\Wire\IrCodec;
use Eleph\Gen\WPGraphQL\Wire\WireException;

/**
 * The WPGraphQL builder: the integration's declaration, and the manifest it compiles to.
 *
 * Both halves belong to this package and to nothing else. The keys `integrations:
 * wpgraphql` accepts are a property of WPGraphQL, and so is what an exposed entity
 * compiles to — so the same program answers both, and a project that never installs
 * this package can neither name the integration nor find its manifest.
 *
 * That is the whole point of it being a builder. Before, the compiler hardcoded both,
 * which meant installing the Elephentity CLI installed GraphQL support whether the
 * project wanted it or not.
 *
 * See PROTOCOL.md in elephentity-codegen for the contract this implements, and
 * docs/BUILDERS.md for why the manifest and verifier this writes name
 * `Eleph\WPGraphQL\*` classes as plain strings rather than importing them: this
 * repository depends on nothing of Elephentity's, only an agreement about what a
 * project with `elephentity/wpgraphql` installed will find there.
 */

// Works both when this is the root project and when it is installed as a dependency.
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (file_exists($autoload)) {
        require $autoload;

        break;
    }
}

try {
    $request = BuilderEnvelope::read((string) file_get_contents('php://stdin'));

    BuilderEnvelope::assertVersions($request);

    if (BuilderEnvelope::REQUEST_DESCRIBE === BuilderEnvelope::kindOf($request)) {
        fwrite(STDOUT, BuilderEnvelope::write(BuilderEnvelope::description([
            'integrations' => [WpGraphQL::NAME => IntegrationCodec::encode(WpGraphQL::definition())],
        ])));

        exit(0);
    }

    $schema = IrCodec::decode(BuilderEnvelope::schemaOf($request));

    // A project that speaks no GraphQL gets no files rather than an empty manifest.
    // Finding one in the tree and wondering where it came from is worse than not
    // configuring the target at all. verify.php rides along for the same reason: with
    // no manifest beside it, it would have nothing to check and no way to check it.
    $files = $schema->project->speaks(WpGraphQL::NAME)
        ? [
            'graphql-manifest.php' => (new ManifestExporter())->export((new ManifestBuilder())->build($schema)),
            'verify.php' => (new VerifierExporter())->export(),
        ]
        : [];

    fwrite(STDOUT, BuilderEnvelope::write(BuilderEnvelope::response($files)));
} catch (WireException $exception) {
    fwrite(STDERR, 'eleph-gen-wpgraphql: ' . $exception->getMessage() . "\n");

    exit(1);
} catch (RuntimeException $exception) {
    // A published query returning an unexposed type, and anything else the manifest
    // builder refuses. A response with errors rather than a crash, so the orchestrator
    // pools it with whatever else went wrong in the same run.
    fwrite(STDOUT, BuilderEnvelope::write(BuilderEnvelope::response([], [$exception->getMessage()])));
}

exit(0);
